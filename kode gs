function doGet(e) {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Sheet1");
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) {
    return ContentService.createTextOutput(JSON.stringify({ status: "empty", data: [] }))
      .setMimeType(ContentService.MimeType.JSON);
  }

  // Ambil 3 kolom: Nama | Penjelasan | COU
  const data = sheet.getRange(2, 1, lastRow - 1, 3).getValues();

  const keyword = (e.parameter.name || "").toLowerCase().trim();
  let results = [];

  data.forEach(row => {
    const nama = (row[0] + "").toLowerCase().trim();
    if (nama.startsWith(keyword)) {
      results.push({
        nama: row[0],
        penjelasan: row[1],
        cou: row[2]
      });
    }
  });

  return ContentService.createTextOutput(JSON.stringify({
    status: results.length > 0 ? "found" : "not_found",
    total: results.length,
    data: results
  })).setMimeType(ContentService.MimeType.JSON);
}

